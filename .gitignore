# Node
node_modules/
.next/
out/
dist/
build/
# TypeScript incremental build cache (regenerated on every tsc run)
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
# Throwaway experiment venv holding a ROCm build of torch (AMD GPU MinerU
# benchmark). Kept out of the lockfile on purpose — the main venv pins torch
# to the CUDA index for the Windows dev box, and mixing the two would break
# reproducibility. See docs/superpowers/investigations/2026-07-31-rocm-mineru-benchmark.md
.venv-rocm/
venv/
env/
*.egg-info/
.pytest_cache/

# Environment
.env
.env.local
.env.*.local
*.env

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Project-specific — extractor outputs are reproducible and large; only the
# per-extractor README (setup notes + version pinning) is tracked. Negation
# patterns require the parent dirs to NOT be excluded with trailing-slash,
# so we ignore everything inside via `**` then re-include the dir tree.
samples/extractor-output/**
!samples/extractor-output/
!samples/extractor-output/*/
!samples/extractor-output/*/README.md
samples/raw-pdfs/
# samples/raw-docx/ is NOT ignored — see CLAUDE.md "Sample primary sources".
# DOCX files are user-uploaded primary sources (e.g., legislative bills) that
# can't be auto-fetched from a public URL the way PDFs can. Committing them
# keeps them on disk across worktrees and fresh clones.

# Phase 1a runtime data — large, reproducible. The smaller curated
# artifacts (data/discovery-cache.yaml, data/fund-catalog.yaml,
# data/system-prompt-context.md, data/ingest-plan.yaml) ARE tracked.
data/cached-pdfs/
data/extractor-output/
# data/chunks/ contents are reproducible and large; gitignore everything
# except MANIFEST.md (the Phase-1a → Phase-1b hand-off contract). Negation
# patterns require the parent dir NOT to be excluded with trailing-slash,
# so we ignore everything inside via `**` then re-include the dir + manifest.
data/chunks/**
!data/chunks/
!data/chunks/MANIFEST.md
# Audit JSON outputs are reproducible — gitignore.
data/audit/
# Dev-machine shared-data root (LanceDB tables, pdfs, settings). Production
# points JLBC_DATA_DIR at the office share; dev falls back to here.
data/insight-data/

*.tmp
.tmp-*/

# Postgres / database
*.db
*.sqlite
postgres-data/
# Phase 1b local-dev Postgres data volume (Docker compose bind mount)
db/data/

# Test artifacts
coverage/
.nyc_output/

# Visual brainstorming companion sessions (mockups, server state)
.superpowers/

# Companion app builds
companion-dist/
companion-out/

# Vite webapp (Plan 2). Root-level node_modules/ + dist/ patterns already match
# these, but pin them explicitly so the webapp build output can never be staged.
webapp/node_modules/
# …and again WITHOUT the trailing slash, because a `dir/` pattern does not
# match a SYMLINK to a directory. CLAUDE.md requires non-trivial work to happen
# in a git worktree, and the cheap way to test in one is to symlink the main
# checkout's node_modules and .venv rather than provision multi-GB copies. With
# only the slashed patterns, both show up as untracked in every worktree and a
# `git add -A` commits them.
webapp/node_modules
.venv
webapp/dist/

.youcoded/

# Bundle builder output (Plan 5 Task 15). `build/` is the staged bundle tree
# (~3.3 GB) and `dist/` holds the shipped zip; both are regenerated by
# `python packaging/build_bundle.py` and must never be staged.
build/
dist/

# Layer 2 agent-eval raw transcripts (full chunk text; scores/judge/compare ARE committed)
eval/results/agent/*/*-r*.jsonl
eval/results/agent/*/ledger.jsonl
