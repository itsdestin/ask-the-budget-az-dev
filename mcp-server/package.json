{
  "name": "budget-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the Ask the Budget AZ retrieve() and cite() tools to a running YouCoded instance.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "budget-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p . --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
