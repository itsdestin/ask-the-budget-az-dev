# Copy to .env.local at the repo root, then `set -a; source .env.local; set +a` (or use direnv).
# Do NOT commit .env.local — it goes into .gitignore.

# Postgres password used by docker-compose.yml + DATABASE_URL.
# Local-dev only; production stack would manage this via a secrets store.
POSTGRES_PASSWORD=askbudget-dev

# psycopg connection URL. The Docker compose binds to 127.0.0.1:5432.
DATABASE_URL=postgresql://askbudget:askbudget-dev@127.0.0.1:5432/askbudget

# Voyage AI key for Phase 1b WS3 (embeddings) + WS6 (rerank). Not required for WS1 (this workstream).
# Get from https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=
